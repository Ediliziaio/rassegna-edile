      "destination": "/serramenti-infissi/renova-solution-confrontare-le-alternative-per-le-nuove-finestre/",
      "permanent": true
    },
    {
      "source": "/speciali-aziende/renova-solution-confrontare-le-alternative-per-le-nuove-finestre",
      "destination": "/serramenti-infissi/renova-solution-confrontare-le-alternative-per-le-nuove-finestre/",
      "permanent": true
    },
    {
      "source": "/speciali-aziende/innovasol-dare-una-priorita-tra-fotovoltaico-e-solare-termico/",
      "destination": "/efficienza-energetica/innovasol-dare-una-priorita-tra-fotovoltaico-e-solare-termico/",
